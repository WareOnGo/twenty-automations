{
  "name": "crm-automations",
  "version": "1.0.0",
  "description": "CRM Automations Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=192 src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "npx prisma generate",
