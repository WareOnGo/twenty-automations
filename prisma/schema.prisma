generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Local mirror of Twenty CRM opportunities, refreshed by the polling sync job.
// `data` holds the latest depth=1 snapshot and is the source we diff against to
// detect qualifying ("meaningful") MANUAL changes. The compliance clocks below
// are computed by us — they are NOT Twenty's `updatedAt` (which misses note/task
// additions and bumps on our own API writebacks).
model Opportunity {
  opportunityId String    @id @map("opportunity_id")
  data          Json
  stage         String?
  assigneeEmail String?   @map("assignee_email")

  // NOTE: the webhook/reminder-era columns (last_activity_at, created_at,
  // reminder_*, update_count) still exist physically in Postgres but are no
  // longer modelled here — that code is gone. They all carry DB defaults, so
  // inserts through Prisma are unaffected. Run sql/drop_legacy_reminder_columns.sql
  // to drop them for good.

  // Denormalized, queryable copies of Twenty fields (refreshed each poll)
  name        String?
  priority    String? // RATING_1..RATING_5 (priority stars) or null
  city        String?
  companyName String? @map("company_name")
  assignedTo  Json?   @map("assigned_to") // array of Twenty enum names, e.g. ["DHAVAL","MANOHARI"]
  ownerId     String? @map("owner_id") // Twenty workspace member id

  // Native Twenty date fields, mirrored
  lastContacted DateTime? @map("last_contacted") @db.Timestamptz(6)
  nextFollowUp  DateTime? @map("next_follow_up") @db.Timestamptz(6)

  // Twenty's own timestamps (opportunity delta-poll watermark + stage-change time)
  twentyCreatedAt DateTime? @map("twenty_created_at") @db.Timestamptz(6)
  twentyUpdatedAt DateTime? @map("twenty_updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Compliance clocks we compute ("our own updated_at")
  lastMeaningfulUpdateAt   DateTime? @map("last_meaningful_update_at") @db.Timestamptz(6)
  lastMeaningfulUpdateKind String?   @map("last_meaningful_update_kind") // opportunity | note | task | attachment | stage
  lastMeaningfulUpdateBy   String?   @map("last_meaningful_update_by")
  lastNoteAt               DateTime? @map("last_note_at") @db.Timestamptz(6)
  lastNoteText             String?   @map("last_note_text") // truncated bodyV2.markdown of most recent note (Mail 1)
  lastTaskAt               DateTime? @map("last_task_at") @db.Timestamptz(6)
  stageEnteredAt           DateTime? @map("stage_entered_at") @db.Timestamptz(6) // when current stage began -> SLA color

  // Bookkeeping
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastPolledAt DateTime? @map("last_polled_at") @db.Timestamptz(6)

  // Set when the Mail 4 closure checklist has been sent for this deal, so the
  // trigger scan never sends twice. Null = not yet sent.
  closureSentAt DateTime? @map("closure_sent_at") @db.Timestamptz(6)

  @@index([stage])
  @@index([assigneeEmail])
  @@index([lastMeaningfulUpdateAt])
  @@index([twentyUpdatedAt])
  @@map("opportunities")
}

// Append-only log of stage changes detected by the poller. Drives time-in-stage
// SLA history, proposal-share grading (A-F by TAT), and stage-wise TAT reports.
model StageTransition {
  id            BigInt   @id @default(autoincrement())
  opportunityId String   @map("opportunity_id")
  fromStage     String?  @map("from_stage")
  toStage       String   @map("to_stage")
  changedAt     DateTime @map("changed_at") @db.Timestamptz(6) // opp's Twenty updatedAt when the change was detected
  detectedAt    DateTime @default(now()) @map("detected_at") @db.Timestamptz(6)

  @@index([opportunityId])
  @@index([toStage])
  @@map("stage_transitions")
}

// Full depth=1 REST note/task snapshots, including records without an opportunity.
// The additive SQL migration also enables RLS and revokes public/API-role access.
model CrmRecord {
  object          String
  recordId        String    @map("record_id")
  data            Json
  opportunityIds  String[]  @map("opportunity_ids")
  twentyCreatedAt DateTime? @map("twenty_created_at") @db.Timestamptz(6)
  twentyUpdatedAt DateTime? @map("twenty_updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastPolledAt    DateTime  @default(now()) @map("last_polled_at") @db.Timestamptz(6)

  @@id([object, recordId])
  @@index([object, twentyUpdatedAt])
  @@index([opportunityIds], type: Gin)
  @@map("crm_records")
}

// One row per polled Twenty object type. Stores the high-water mark so each poll
// records the newest completely persisted source update. Full snapshots are
// refreshed every cycle because relation edits do not change parent updatedAt.
model SyncCheckpoint {
  object        String    @id // "opportunities" | "notes" | "tasks"
  lastUpdatedAt DateTime? @map("last_updated_at") @db.Timestamptz(6) // watermark (max updatedAt seen)
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastRunStatus String?   @map("last_run_status") // ok | error
  lastError     String?   @map("last_error")

  @@map("sync_checkpoints")
}

