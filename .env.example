PORT=3000

DATABASE_URL=

TWENTY_CRM_BASE_URL=
TWENTY_CRM_API_KEY=

OPENAI_API_KEY=

RESEND_API_KEY=
RESEND_FROM=

# Shared secret guarding every pg_cron-triggered endpoint: /sync,
# /morning-briefing, /admin-briefing, /closure-checklist, /lead-reminders. Must match the X-Auth
# header value in sql/pg_cron_*.sql. Without it those endpoints refuse all
# requests with 503. Named for the retired reminder system — renaming it means
# changing the prod .env and every SQL job at the same time.
REMINDER_SECRET=

# Comma-separated list of Twenty `assignedTo` enum values (uppercased first
# names of workspace members). The /rfq parser uses this to validate names
# extracted from WhatsApp messages. Anything not in this list is silently
# ignored. Update + restart whenever a teammate is added/removed in Twenty.
ASSIGNABLE_USERS=DHAVAL,JAYANTH,NIKESH,RANITA,MANEESH,ARNAV,MANOHARI,NIHAS,RAGHAV

# Assignment-reminder beta. Disabled until migration, cutoff and transport are configured.
CRM_LEAD_REMINDERS_ENABLED=false
# Fixed source-creation cutoff: 27 Oct 2026, 00:00 IST (or a later activation time).
# Earlier cutoffs are rejected. Reassigning a historical lead never enrolls it.
CRM_REMINDER_NEW_LEADS_FROM=2026-10-27T00:00:00+05:30
# VerifiedNumber IDs: Maneesh=12, Nihas=19, Raghav=1, Dhaval=2, Jayanth=5, Arnav=14.
CRM_REMINDER_BETA_EMPLOYEE_IDS=12,19,1,2,5,14
# Escalation receivers and assignees whose own sequences never escalate.
CRM_REMINDER_ESCALATION_EMPLOYEE_IDS=2,5
CRM_REMINDER_ESCALATION_EXEMPT_EMPLOYEE_IDS=2,5
# Explicit CRM enum -> DB identity mapping; no email address required.
CRM_REMINDER_ASSIGNEE_MAP={"MANEESH":12,"NIHAS":19,"RAGHAV":1,"DHAVAL":2,"JAYANTH":5,"ARNAV":14}
RAMESH_API_URL=https://wareongo-ramesh.duckdns.org
RAMESH_AUTOMATION_API_KEY=
